<Project Sdk="Uno.Sdk">
 <PropertyGroup>
  <TargetFrameworks>net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
  <TargetFrameworks Condition="'$(ArtSpaceDesktopOnly)' == 'true'">net10.0-desktop</TargetFrameworks>
  <UnoSingleProject>true</UnoSingleProject><OutputType>Library</OutputType><GenerateLibraryLayout>true</GenerateLibraryLayout>
  <UnoFeatures>SkiaRenderer;</UnoFeatures><IsPackable>true</IsPackable>
  <Description>Embeddable Uno/Skia design surface with direct manipulation, vector tools, snapping, text editing and presentation.</Description>
 </PropertyGroup>
 <ItemGroup>
  <ProjectReference Include="../ArtSpace.Controls/ArtSpace.Controls.csproj" />
  <ProjectReference Include="../ArtSpace.Skia/ArtSpace.Skia.csproj" />
 </ItemGroup>
</Project>
